# Sayfer Bio — environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. This file holds NAMES AND PLACEHOLDERS ONLY.
#
# Only the contact form uses these. Everything else on the site is static.


# ── Email delivery (Resend) ───────────────────────────────────────────────────

# Server-only. Never exposed to the browser.
# Create at https://resend.com → API Keys. A "Sending access" key is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact enquiries are delivered. For production this is:
#   sai@sayferbio.com
# Read from the environment, never hardcoded, so it can change without a deploy
# of new application code.
CONTACT_TO_EMAIL=you@example.com

# The address enquiries are sent FROM. Its domain must be verified in Resend
# before real delivery works.
#
#   Before the domain is verified, Resend's shared test sender works and can
#   only deliver to the address that owns the Resend account:
#     CONTACT_FROM_EMAIL="Sayfer Bio <onboarding@resend.dev>"
#
#   Once sayferbio.com is verified in Resend, change this to something like:
#     CONTACT_FROM_EMAIL="Sayfer Bio <website@sayferbio.com>"
#     CONTACT_FROM_EMAIL="Sayfer Bio <contact@sayferbio.com>"
#
# The visitor's own address is never used here — it would fail SPF/DKIM and land
# in spam. Their address is set as Reply-To instead.
CONTACT_FROM_EMAIL="Sayfer Bio <onboarding@resend.dev>"


# ── Spam protection (Cloudflare Turnstile) ────────────────────────────────────

# Public. Shipped to the browser to render the widget; that is what it is for.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000

# Server-only. Verifies the widget's token with Cloudflare.
# If this is missing the form REFUSES submissions rather than skipping the
# check, so an unconfigured deployment fails closed rather than open.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Local development without a Cloudflare account:
# Cloudflare publishes dummy keys that are safe to use and are not secrets.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#
#   always passes:  NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#                   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   always blocks:  NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
#                   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
